# Copier ce fichier : cp .env.example .env
# Modifier les valeurs de .env AVANT le premier lancement de Docker Compose.
# Ne jamais publier .env : il contient le mot de passe de votre base.

# Nom de votre base PostgreSQL. Valeur générique à personnaliser si souhaité.
POSTGRES_DB=mysold
# Utilisateur technique PostgreSQL, partagé par la base et l’API.
POSTGRES_USER=mysold
# OBLIGATOIRE : renseigner un mot de passe long, unique et privé.
# Aucun mot de passe n’est généré automatiquement ; une valeur vide bloque Docker.
# Ce secret n’est PAS le mot de passe de connexion d’un utilisateur MySold.
# Utiliser des quotes simples si la valeur contient un $ ou un #.
POSTGRES_PASSWORD=
# Conserver ces trois valeurs après initialisation de la base.
# Modifier ce fichier seul ne renomme pas une base et ne change pas son mot de passe.

# Port HTTP publié sur votre serveur. Configurer votre pare-feu et votre proxy.
WEB_PORT=28085
# Adresse EXACTE utilisée dans votre navigateur : protocole + domaine/IP + port.
# Remplacer localhost par VOTRE domaine pour un accès distant, par exemple :
# APP_ORIGIN=https://finances.example.com
# Plusieurs origines sont séparées par des virgules, sans joker ni chemin.
APP_ORIGIN=http://localhost:28085
# Mettre true si votre site est accessible en HTTPS derrière un reverse proxy.
COOKIE_SECURE=false
# Mettre false pour fermer les nouvelles inscriptions.
ALLOW_REGISTRATION=true

# À modifier uniquement pour un fork qui publie ses propres releases Web.
MYSOLD_REPOSITORY=ABP-Display/MySold
# SDK utilisé uniquement par compose.source.yaml pour le développement.
FLUTTER_VERSION=3.44.0
