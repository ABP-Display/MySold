# Copier ce fichier : cp .env.example .env
# Modifier les valeurs de .env AVANT le premier lancement de Docker Compose.
# Ne jamais publier .env : il contient le mot de passe de votre base.

# Nom de votre base PostgreSQL. Valeur générique à personnaliser si souhaité.
POSTGRES_DB=mysold
# Utilisateur technique PostgreSQL, partagé par la base et l’API.
POSTGRES_USER=mysold
# OBLIGATOIRE : renseigner un mot de passe long, unique et privé.
# Aucun mot de passe n’est généré automatiquement ; une valeur vide bloque Docker.
# Ce secret n’est PAS le mot de passe de connexion d’un utilisateur MySold.
# Utiliser des quotes simples si la valeur contient un $ ou un #.
POSTGRES_PASSWORD=
# Conserver ces trois valeurs après initialisation de la base.
# Modifier ce fichier seul ne renomme pas une base et ne change pas son mot de passe.

# Port HTTP publié sur votre serveur. Configurer votre pare-feu et votre proxy.
WEB_PORT=28080
# Garder le HTTP en boucle locale sauf besoin explicite pour un proxy de confiance.
WEB_BIND_ADDRESS=127.0.0.1
# true pour servir HTTPS avec vos propres certificats.
TLS_ENABLED=false
WEB_HTTPS_PORT=28443
WEB_HTTPS_BIND_ADDRESS=0.0.0.0
# Dossier privé contenant fullchain.pem et privkey.pem, jamais sous frontend/.
TLS_CERTS_DIR=./data/tls
# GID numérique du groupe dédié mysold-tls sur le serveur, à renseigner pour HTTPS.
TLS_CERT_GID=
# Adresse EXACTE utilisée dans votre navigateur : protocole + domaine/IP + port.
# HTTPS obligatoire à distance ; HTTP autorisé uniquement en boucle locale.
# Remplacer localhost par VOTRE domaine pour un accès distant, par exemple :
# APP_ORIGIN=https://finances.example.com
# Plusieurs origines sont séparées par des virgules, sans joker ni chemin.
APP_ORIGIN=http://localhost:28080
# Mettre true si votre site est accessible en HTTPS derrière un reverse proxy.
COOKIE_SECURE=false
# Mettre false pour fermer les nouvelles inscriptions.
ALLOW_REGISTRATION=true

# Présentation publique : /presentation ; l’application reste à / et n’est pas indexée.
# URL sans chemin, déjà autorisée dans APP_ORIGIN. Vide : priorité à une origine HTTPS.
# Exemple pour l’instance officielle : https://mysold.ydoxide.fr
PUBLIC_SITE_URL=
# false pour une instance privée ou de test. HTTP local n’est jamais indexable.
PUBLIC_INDEXING=true
# Coordonnées PUBLIQUES, affichées dans les notices de CETTE instance.
# L’instance officielle indique ydoxide ; personnaliser pour un autre exploitant.
PUBLIC_OPERATOR_NAME=
PUBLIC_OPERATOR_ADDRESS=
PUBLIC_CONTACT_URL=https://github.com/ABP-Display/MySold
# Recommandé : un canal confidentiel pour les demandes de données personnelles.
# Ne jamais demander aux utilisateurs de publier leurs données dans une issue.
PUBLIC_CONTACT_EMAIL=
PUBLIC_HOSTING_NAME=
PUBLIC_HOSTING_ADDRESS=
PUBLIC_HOSTING_CONTACT=
PUBLIC_HOSTING_REGION=
# Décrire les durées et procédures réellement appliquées : pas de purge inventée.
PUBLIC_LOG_RETENTION=
PUBLIC_BACKUP_RETENTION=

# À modifier uniquement pour un fork qui publie ses propres releases Web.
MYSOLD_REPOSITORY=ABP-Display/MySold
# Utiliser Dockerfile.source pour compiler localement au lieu de télécharger la release.
WEB_DOCKERFILE=Dockerfile
# SDK utilisé uniquement pour la compilation depuis les sources.
FLUTTER_VERSION=3.44.0

# Chiffrement : data/keys/master.key est créé automatiquement et persiste.
# Sauvegarder data/keys ET PostgreSQL ; perdre la clé rend les données illisibles.
# Ne jamais ajouter de clé de chiffrement à ce modèle ou dans Git.
