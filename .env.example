# Optional configuration: cp .env.example .env, then edit for your own server.
# Docker Compose works without .env using the defaults below.
POSTGRES_DB=mysold
POSTGRES_USER=mysold
# Leave empty to generate a private random secret at first startup.
# It is stored in data/config/postgres_password and reused on every restart.
# This technical secret is NOT the password of a MySold user account.
# An optional custom value is used only to initialize a new installation.
POSTGRES_PASSWORD=
# Published on all host interfaces. Configure your firewall and proxy as needed.
WEB_PORT=28085
# Replace with your own exact public URL before deploying (scheme + host + port).
# Multiple allowed origins are comma-separated. No wildcard or path.
APP_ORIGIN=http://localhost:28085,https://mysold.ydoxide.fr
# Set true for HTTPS deployments.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
# Public GitHub repository publishing the matching frontend release (forks).
MYSOLD_REPOSITORY=ABP-Display/MySold
# Only used by compose.source.yaml for local development builds.
FLUTTER_VERSION=3.44.0
