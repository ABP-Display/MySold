# Use a stamped release built on a workstation/CI instead of compiling Flutter
# on a small VPS. The matching .dockerignore admits only public Web assets.
FROM nginxinc/nginx-unprivileged:stable-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY build/web/ /usr/share/nginx/html/
RUN test -s /usr/share/nginx/html/main.dart.js \
    && test -s /usr/share/nginx/html/version.json \
    && ! grep -q '__MYSOLD_BUILD_ID__' /usr/share/nginx/html/sw.js
EXPOSE 8080
